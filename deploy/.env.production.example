# Скопировать в deploy/.env.production, заменить все CHANGE_ME и не добавлять в Git.
# Docker Compose читает этот файл через --env-file.

# Frontend: внешний Nginx на сервере проксирует в этот localhost-порт.
APP_PORT=127.0.0.1:18080

# PostgreSQL
POSTGRES_DB=ztz_passes
POSTGRES_USER=ztz_passes
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_DATABASE_PASSWORD

# Начальные учётные записи: создаются только при первом запуске, если отсутствуют.
DEMO_LOGIST_USERNAME=logist
DEMO_LOGIST_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_LOGIST_PASSWORD
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_ADMIN_PASSWORD

SESSION_TTL_HOURS=12
COOKIE_SECURE=true
