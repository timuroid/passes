# Заменить passes.intbis.ru на выбранный поддомен зоны intbis.ru.
# Этот Nginx установлен на хосте; Compose frontend слушает только 127.0.0.1:18080.

server {
    listen 80;
    listen [::]:80;
    server_name passes.intbis.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name passes.intbis.ru;

    ssl_certificate /etc/letsencrypt/live/passes.intbis.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/passes.intbis.ru/privkey.pem;

    location /api/events {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
